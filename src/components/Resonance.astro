---
const thoughts = [
  "Você é mais que um CID.",
  "Sua dor tem um lugar.",
  "Aqui, o silêncio também fala.",
  "Construção conjunta.",
  "Presença real."
]
---

<section class="py-32 overflow-hidden bg-[#FAF9F6] select-none border-b border-brand-gold/5">
  <!-- First Marquee: Right to Left -->
  <div class="flex whitespace-nowrap overflow-hidden">
    <div class="flex animate-marquee py-4">
      {thoughts.map((thought) => (
        <span class="text-[clamp(2rem,5vw,4rem)] font-serif italic text-brand-blue/[0.15] mx-12 hover:text-brand-gold transition-colors duration-500 cursor-default">
          {thought} —
        </span>
      ))}
    </div>
    <div class="flex animate-marquee py-4" aria-hidden="true">
      {thoughts.map((thought) => (
        <span class="text-[clamp(2rem,5vw,4rem)] font-serif italic text-brand-blue/[0.15] mx-12 hover:text-brand-gold transition-colors duration-500 cursor-default">
          {thought} —
        </span>
      ))}
    </div>
  </div>

  <!-- Second Marquee: Left to Right -->
  <div class="flex whitespace-nowrap overflow-hidden mt-8">
    <div class="flex animate-marquee-reverse py-4">
      {[...thoughts].reverse().map((thought) => (
        <span class="text-[clamp(1.5rem,4vw,3rem)] font-serif text-brand-gold/[0.2] mx-12 hover:text-brand-blue transition-colors duration-500 cursor-default">
          {thought} —
        </span>
      ))}
    </div>
    <div class="flex animate-marquee-reverse py-4" aria-hidden="true">
      {[...thoughts].reverse().map((thought) => (
        <span class="text-[clamp(1.5rem,4vw,3rem)] font-serif text-brand-gold/[0.2] mx-12 hover:text-brand-blue transition-colors duration-500 cursor-default">
          {thought} —
        </span>
      ))}
    </div>
  </div>
</section>

<style>
  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  @keyframes marquee-reverse {
    0% { transform: translateX(-50%); }
    100% { transform: translateX(0); }
  }
  .animate-marquee {
    animation: marquee 40s linear infinite;
  }
  .animate-marquee-reverse {
    animation: marquee-reverse 30s linear infinite;
  }
</style>
