---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  image?: string | undefined;
  slug: string;
}

const { title, description, pubDate, image = "", slug } = Astro.props;
const formattedDate = pubDate.toLocaleDateString('pt-BR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<a href={`/blog/${slug}`} class="group block scroll-reveal">
  <div class="relative aspect-[16/10] overflow-hidden rounded-2xl bg-brand-sand/20 mb-6">
    {image && (
      <img
        src={image}
        alt={title}
        class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
      />
    )}
    <div class="absolute inset-0 bg-gradient-to-t from-brand-blue/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
  </div>
  
  <div class="space-y-3">
    <div class="flex items-center gap-3 text-sm font-sans tracking-wider text-brand-gold uppercase">
      <span>{formattedDate}</span>
      <span class="w-1 h-1 rounded-full bg-brand-gold"></span>
      <span>Post</span>
    </div>
    
    <h3 class="text-2xl font-serif text-brand-blue group-hover:text-brand-gold transition-colors duration-300 decoration-brand-gold/30 underline-offset-4 group-hover:underline">
      {title}
    </h3>
    
    <p class="text-brand-blue/70 line-clamp-2 font-sans font-light leading-relaxed">
      {description}
    </p>
    
    <div class="pt-4 flex items-center gap-2 text-brand-blue font-sans text-sm font-medium">
      Ler artigo completo
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover:translate-x-1"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
    </div>
  </div>
</a>
