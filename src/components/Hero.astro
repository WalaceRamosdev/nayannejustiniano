---
import { Image } from "astro:assets";
import heroineImage from "../assets/images/fundoRemovido.png";
---

<section
  class="relative min-h-screen flex items-center overflow-hidden px-6 pt-32 lg:pt-64 pb-12 bg-[#F3F0E9] border-b border-brand-gold/5"
>
  <!-- Background atmospheric layers -->
  <div class="absolute inset-0 z-0 pointer-events-none">
    <div
      class="absolute top-0 right-0 w-2/3 h-full bg-gradient-to-l from-brand-gold/5 via-brand-gold/[0.02] to-transparent"
    >
    </div>
    <div
      class="absolute -bottom-[10%] -left-[10%] w-[40%] h-[40%] bg-blue-100/30 rounded-full blur-[120px]"
    >
    </div>

    <!-- Large background letter -->
    <div
      class="absolute left-10 top-1/2 -translate-y-1/2 font-serif text-[35vw] text-brand-blue/[0.01] select-none leading-none"
    >
      N
    </div>
  </div>

  <div class="container mx-auto relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-24 items-center">
      <!-- Content Left -->
      <div class="lg:col-span-7 space-y-16">
        <div class="inline-flex items-center gap-4 scroll-reveal mb-8 lg:mb-16">
          <div class="w-12 h-px bg-brand-gold"></div>
          <span
            class="text-[0.65rem] uppercase tracking-[0.5em] font-black text-brand-gold"
            >Psicologia Fenomenológica Existencial</span
          >
        </div>

        <h1
          class="font-serif text-[clamp(3.5rem,8vw,8rem)] leading-[0.9] text-brand-blue tracking-tighter mb-16 scroll-reveal"
          style="transition-delay: 200ms;"
        >
          Acolher a sua <br />
          <span class="italic font-light text-brand-blue/80">existência</span>
          <br />
          <span class="relative inline-block">
            em sua totalidade.
            <div
              class="absolute -bottom-2 lg:-bottom-4 left-0 w-full h-px bg-brand-gold/30"
            >
            </div>
          </span>
        </h1>

        <p
          class="text-xl md:text-3xl text-brand-blue/70 font-light leading-relaxed max-w-2xl mb-16 scroll-reveal"
          style="transition-delay: 400ms;"
        >
          Um espaço ético de <span class="text-brand-blue font-medium italic"
            >escuta profunda</span
          >, onde o foco não é o diagnóstico, mas quem você é no mundo.
        </p>

        <div
          class="flex flex-col sm:flex-row items-start sm:items-center gap-12 pt-8 scroll-reveal"
          style="transition-delay: 600ms;"
        >
          <a
            href="https://wa.me/5531991838243"
            class="group relative px-12 py-6 bg-brand-blue text-white rounded-full text-xl font-bold overflow-hidden shadow-2xl shadow-brand-blue/20 hover:scale-105 active:scale-95 transition-all"
          >
            <span class="relative z-10">Agendar agora</span>
            <div
              class="absolute inset-0 bg-brand-gold translate-y-full group-hover:translate-y-0 transition-transform duration-500"
            >
            </div>
          </a>

          <div class="flex items-center gap-6 group cursor-pointer">
            <div
              class="w-14 h-14 rounded-full border border-brand-gold/30 flex items-center justify-center group-hover:bg-brand-gold group-hover:border-brand-gold transition-all duration-500"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-brand-gold group-hover:text-white transition-colors translate-x-0.5"
                ><polygon points="5 3 19 12 5 21 5 3"></polygon></svg
              >
            </div>
            <span
              class="text-[0.7rem] uppercase tracking-[0.4em] font-black text-brand-blue/60 group-hover:text-brand-blue transition-colors"
              >Conhecer processo</span
            >
          </div>
        </div>
      </div>

      <!-- Image Right -->
      <div
        class="lg:col-span-5 relative scroll-reveal"
        style="transition-delay: 400ms;"
      >
        <div
          class="relative w-full aspect-[4/5] flex items-end justify-center group mt-20 lg:mt-0"
        >
          <!-- The "Frame" / Backplate (Darkened for better contrast) -->
          <div
            class="absolute bottom-0 w-[85%] h-[85%] bg-brand-blue/5 rounded-t-[15rem] border border-brand-gold/10 shadow-2xl overflow-hidden"
          >
            <div
              class="absolute inset-0 bg-gradient-to-b from-brand-gold/10 to-transparent"
            >
            </div>
            <!-- Interactive glow inside frame -->
            <div
              class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-64 h-64 bg-brand-gold/20 rounded-full blur-[80px] opacity-0 group-hover:opacity-100 transition-opacity duration-1000"
            >
            </div>
          </div>

          <!-- The Popping Image (Aligned to bottom) -->
          <div
            class="relative z-10 w-full hover:scale-105 transition-transform duration-700 pointer-events-none flex items-baseline"
          >
            <Image
              src={heroineImage}
              alt="Nayanne Justiniano"
              class="w-full h-auto drop-shadow-[0_20px_50px_rgba(10,18,30,0.2)] block"
            />
          </div>

          <!-- Floating Status (Interactive) -->
          <div
            class="absolute bottom-10 -right-8 z-20 hidden xl:block animate-float"
          >
            <div
              class="bg-white/90 backdrop-blur-xl p-8 rounded-3xl border border-white/40 shadow-2xl flex items-center gap-6"
            >
              <div
                class="w-3 h-3 bg-brand-gold rounded-full animate-pulse shadow-[0_0_15px_rgba(197,160,89,0.5)]"
              >
              </div>
              <div class="space-y-1">
                <p
                  class="text-[0.6rem] uppercase tracking-widest font-black text-brand-gold"
                >
                  Status
                </p>
                <p class="text-xs font-serif text-brand-blue">
                  Disponível para novos processos
                </p>
              </div>
            </div>
          </div>

          <!-- Decorative Elements -->
          <div
            class="absolute -bottom-10 -left-10 w-32 h-32 bg-brand-blue rounded-full blur-[60px] opacity-10"
          >
          </div>
        </div>

        <!-- Large Background Monogram -->
        <div
          class="absolute -right-20 -bottom-20 font-serif text-[25vw] text-brand-blue/[0.02] select-none leading-none -z-10"
        >
          NJ
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll Indicator -->
  <div
    class="absolute bottom-12 left-1/2 -translate-x-1/2 flex flex-col items-center gap-4 scroll-reveal"
    style="transition-delay: 1500ms;"
  >
    <div class="w-px h-16 bg-gradient-to-b from-brand-gold to-transparent">
    </div>
    <span
      class="text-[0.5rem] uppercase tracking-[1em] text-brand-gold font-bold rotate-90 translate-y-8 origin-left"
      >Descubra</span
    >
  </div>
</section>

<style>
  @keyframes blob {
    0% {
      transform: translate(0px, 0px) scale(1);
    }
    33% {
      transform: translate(30px, -50px) scale(1.1);
    }
    66% {
      transform: translate(-20px, 20px) scale(0.9);
    }
    100% {
      transform: translate(0px, 0px) scale(1);
    }
  }
  .animate-blob {
    animation: blob 10s infinite alternate;
  }
  .animation-delay-2000 {
    animation-delay: 2s;
  }
  .animation-delay-4000 {
    animation-delay: 4s;
  }
  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-30px);
    }
  }
  .animate-float {
    animation: float 8s ease-in-out infinite;
  }
</style>
