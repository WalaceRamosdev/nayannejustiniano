---
import { Image } from "astro:assets";
import professionalPhoto from "../assets/images/processed_image_4.png";
---

<section id="sobre" class="py-64 px-6 bg-white relative overflow-hidden">
  <!-- Interactive background detail -->
  <div
    class="absolute -left-20 top-1/2 -translate-y-1/2 font-serif text-[40vw] text-brand-blue/[0.01] select-none leading-none rotate-90"
  >
    Raízes
  </div>

  <div class="container mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-24 items-center">
      <!-- Image Column -->
      <div class="lg:col-span-5 relative scroll-reveal">
        <div class="relative rounded-[3rem] overflow-hidden shadow-2xl group">
          <div
            class="absolute inset-0 bg-brand-blue/20 mix-blend-multiply opacity-0 group-hover:opacity-100 transition-opacity duration-1000"
          >
          </div>
          <Image
            src={professionalPhoto}
            alt="Nayanne Justiniano"
            class="w-full aspect-[3/4] object-cover scale-110 group-hover:scale-100 transition-transform duration-[3s]"
          />
          <!-- Overlay Info -->
          <div
            class="absolute bottom-8 left-8 right-8 p-8 bg-white/10 backdrop-blur-xl border border-white/20 rounded-2xl text-white translate-y-4 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-700"
          >
            <p
              class="text-[0.6rem] uppercase tracking-widest font-black mb-2 text-brand-gold"
            >
              Especialidade
            </p>
            <p class="text-lg font-serif italic">
              "Presença que transforma o silêncio em caminho."
            </p>
          </div>
        </div>

        <!-- Floating Badge (Glassmorphism) -->
        <div
          class="absolute -bottom-12 -right-12 w-44 h-44 bg-brand-blue/40 backdrop-blur-2xl rounded-full flex items-center justify-center p-10 text-center text-white shadow-2xl border border-white/20 animate-float group/badge hover:bg-brand-blue/60 transition-colors duration-500"
        >
          <p
            class="text-[0.65rem] uppercase tracking-[0.2em] leading-tight font-black"
          >
            Escuta <br />Ética & <br />Profunda
          </p>
        </div>
      </div>

      <!-- Text Column -->
      <div class="lg:col-span-7 space-y-12">
        <div class="scroll-reveal">
          <h2
            class="text-[0.65rem] uppercase tracking-[0.6em] font-black text-brand-gold mb-6"
          >
            A Profissional
          </h2>
          <h3
            class="font-serif text-[clamp(2.5rem,6vw,5rem)] text-brand-blue leading-[0.9] tracking-tighter mb-8"
          >
            Nayanne <br />
            <span class="italic font-light text-brand-blue/80">Justiniano.</span
            >
          </h3>
          <div class="w-20 h-px bg-brand-gold mb-12"></div>
        </div>

        <div class="space-y-8 scroll-reveal" style="transition-delay: 200ms;">
          <p
            class="text-2xl md:text-4xl font-light text-brand-blue leading-tight"
          >
            Acredito na terapia como um <span
              class="text-brand-blue font-bold italic underline decoration-brand-gold/30 underline-offset-8"
              >encontro autêntico</span
            > entre dois seres-no-mundo.
          </p>
          <p
            class="text-lg md:text-xl text-brand-blue/70 font-light leading-relaxed max-w-2xl"
          >
            Minha prática clínica é guiada pela <strong
              >Psicologia Fenomenológica Existencial</strong
            >. Aqui, não reduzimos sua dor a um código ou diagnóstico. Buscamos
            compreender os sentidos que você atribui à sua própria vida e as
            possibilidades que se abrem no horizonte do seu vir-a-ser.
          </p>
        </div>

        <div
          class="grid grid-cols-2 gap-12 pt-12 border-t border-brand-gold/10 scroll-reveal"
          style="transition-delay: 400ms;"
        >
          <div class="space-y-2">
            <p
              class="text-[0.6rem] uppercase tracking-widest font-black text-brand-gold"
            >
              Registro
            </p>
            <p class="text-xl font-serif text-brand-blue">CRP 04/84986</p>
          </div>
          <div class="space-y-2">
            <p
              class="text-[0.6rem] uppercase tracking-widest font-black text-brand-gold"
            >
              Abordagem
            </p>
            <p class="text-xl font-serif text-brand-blue">Fenomenologia</p>
          </div>
        </div>

        <div class="pt-8 scroll-reveal" style="transition-delay: 600ms;">
          <a
            href="#atendimento"
            class="group flex items-center gap-6 text-brand-blue hover:text-brand-gold transition-all"
          >
            <span class="text-[0.7rem] uppercase tracking-[0.5em] font-black"
              >Conhecer meu método</span
            >
            <div
              class="w-12 h-12 rounded-full border border-brand-gold/20 flex items-center justify-center group-hover:bg-brand-gold group-hover:scale-110 transition-all duration-500"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-brand-gold group-hover:text-white transition-colors"
                ><line x1="5" y1="12" x2="19" y2="12"></line><polyline
                  points="12 5 19 12 12 19"></polyline></svg
              >
            </div>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
