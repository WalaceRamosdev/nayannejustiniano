---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import heroineImage from '../assets/images/processed_image_4.png';
import clientLogo from '../assets/images/logo.png';

const links = [
  { 
    title: "Agendar Consulta", 
    desc: "Inicie seu processo de escuta através do WhatsApp.",
    href: "https://wa.me/5531991838243", 
    highlight: true,
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17.498 14.382c-.301-.15-1.767-.867-2.04-.966-.273-.101-.473-.15-.673.15-.197.295-.771.964-.944 1.162-.173.199-.347.223-.647.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.521-.075-.148-.672-1.62-.922-2.22-.243-.585-.488-.503-.672-.511-.174-.007-.372-.007-.57-.007-.198 0-.52.074-.793.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.76-.719 2.008-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.073 2c-6.536 0-11.856 5.318-11.859 11.854a11.808 11.808 0 001.622 5.961L0 23.328l3.651-1.03a11.815 11.815 0 005.77 1.512h.005c6.533 0 11.854-5.32 11.858-11.857a11.815 11.815 0 00-3.471-8.384"/></svg>`
  },
  { 
    title: "Conhecer o Site", 
    desc: "Explore meus serviços e filosofia de escuta.",
    href: "/", 
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20M2 12h20M12 2a14.5 14.5 0 0 1 0 20"/></svg>`
  },
  { 
    title: "Localização", 
    desc: "Consultório em Almenara, Minas Gerais.",
    href: "https://goo.gl/maps/placeholder", 
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>`
  },
];
---

<Layout title="Conexões | Nayanne Justiniano">
  <main class="min-h-screen bg-[#FAF9F6] selection:bg-brand-gold/20 flex flex-col items-center px-6 py-20 relative overflow-hidden">
    
    <!-- Sophisticated Background -->
    <div class="fixed inset-0 z-0 pointer-events-none">
       <div class="absolute top-[-10%] left-[-10%] w-[70vw] h-[70vw] bg-brand-gold/5 rounded-full blur-[150px] animate-pulse"></div>
       <div class="absolute bottom-[-10%] right-[-10%] w-[60vw] h-[60vw] bg-brand-blue/5 rounded-full blur-[150px]"></div>
       <div class="absolute inset-0 opacity-[0.04] grain-bg"></div>
    </div>

    <div class="w-full max-w-lg relative z-10 flex flex-col items-center">
       
       <!-- Premium Logo Pill -->
       <div class="mb-12 scroll-reveal text-center">
          <div class="inline-flex items-center bg-white/40 backdrop-blur-2xl px-6 py-3 rounded-full border border-white shadow-xl shadow-brand-blue/5 mb-8">
             <Image src={clientLogo} alt="Logo" class="h-8 w-auto brightness-0 opacity-80" />
          </div>
       </div>

       <!-- Profile Arch -->
       <div class="relative mb-12 scroll-reveal" style="transition-delay: 100ms;">
          <div class="w-48 h-64 bg-white rounded-t-full border-2 border-brand-gold/30 p-2 overflow-hidden shadow-2xl relative animate-float">
             <Image src={heroineImage} alt="Nayanne Justiniano" class="w-full h-full object-cover object-top rounded-t-full" />
             <div class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-white/80 to-transparent"></div>
          </div>
          <!-- Floating Leaf/Accent -->
          <div class="absolute -bottom-4 -right-2 w-16 h-16 bg-brand-blue text-white rounded-full flex items-center justify-center shadow-2xl animate-float" style="animation-delay: 2s;">
             <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19 7-7 3 3-7 7-3-3Z"/><path d="m18 13-1.5-7.5L2 2l3.5 14.5L13 18l5-5Z"/><path d="m2 2 20 20"/></svg>
          </div>
       </div>

       <div class="text-center mb-16 scroll-reveal text-brand-blue" style="transition-delay: 200ms;">
          <h1 class="font-serif text-5xl mb-3 tracking-tighter leading-tight">Nayanne<br/><span class="italic text-brand-gold">Justiniano</span></h1>
          <p class="text-[0.65rem] uppercase tracking-[0.6em] font-black opacity-40">Psicóloga Clínica / CRP 04/84986</p>
       </div>

       <!-- Interactive Cards -->
       <div class="w-full space-y-5">
          {links.map((link, idx) => (
            <a 
              href={link.href} 
              target={link.href.startsWith('http') ? "_blank" : "_self"}
              class={`group relative flex items-center p-8 rounded-[2.5rem] transition-all duration-700 scroll-reveal ${
                link.highlight 
                ? "bg-brand-blue text-white shadow-2xl shadow-brand-blue/30 scale-105 shimmer-border overflow-hidden" 
                : "bg-white border border-brand-blue/5 hover:border-brand-gold/40 shadow-sm hover:shadow-2xl hover:shadow-brand-blue/5"
              }`}
              style={`transition-delay: ${300 + (idx * 150)}ms;`}
            >
              <!-- Shimmer Effect for Highlight -->
              {link.highlight && <div class="shimmer-effect"></div>}

              <div class={`w-14 h-14 rounded-2xl flex items-center justify-center mr-8 transition-all duration-700 ${
                link.highlight ? "bg-brand-gold text-brand-blue group-hover:scale-110" : "bg-brand-blue/5 text-brand-blue group-hover:bg-brand-gold group-hover:text-white"
              }`}>
                <Fragment set:html={link.icon} />
              </div>
              
              <div class="flex-1">
                <span class="block text-sm font-bold uppercase tracking-[0.2em] mb-1">{link.title}</span>
                <span class={`block text-[0.75rem] font-light leading-relaxed italic ${link.highlight ? "opacity-60" : "opacity-40"}`}>{link.desc}</span>
              </div>

              <div class="opacity-0 group-hover:opacity-100 translate-x-4 group-hover:translate-x-0 transition-all duration-500 text-brand-gold">
                 <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
              </div>
            </a>
          ))}
       </div>

       <!-- Sophisticated Footer -->
       <div class="mt-24 text-center scroll-reveal" style="transition-delay: 900ms;">
          <div class="flex justify-center gap-10 mb-12">
             <a href="https://instagram.com" class="text-brand-blue/30 hover:text-brand-gold transition-all hover:scale-125">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
             </a>
          </div>
          
          <div class="flex flex-col items-center gap-6">
             <a href="/" class="text-[0.6rem] uppercase tracking-[0.8em] font-black text-brand-gold hover:text-brand-blue transition-colors flex items-center gap-4 group">
                <div class="w-12 h-px bg-brand-gold/30 group-hover:w-20 transition-all"></div>
                Explore o Site
                <div class="w-12 h-px bg-brand-gold/30 group-hover:w-20 transition-all"></div>
             </a>
             <p class="text-[0.55rem] uppercase tracking-[0.4em] opacity-30 mt-8">Desenvolvido com excelência por Alpha Code</p>
          </div>
       </div>
    </div>
  </main>
</Layout>

<style>
  .grain-bg {
    background-image: url("https://grainy-gradients.vercel.app/noise.svg");
  }
  @keyframes float {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-15px) rotate(3deg); }
  }
  .animate-float {
    animation: float 8s ease-in-out infinite;
  }
  
  /* Shimmer for Highlighted Button */
  .shimmer-effect {
    position: absolute;
    top: 0; left: -100%;
    width: 200%; height: 100%;
    background: linear-gradient(
      120deg,
      transparent,
      rgba(197, 160, 89, 0.1),
      transparent
    );
    animation: shimmer 4s infinite linear;
  }
  @keyframes shimmer {
    0% { transform: translateX(0); }
    100% { transform: translateX(100%); }
  }
</style>
