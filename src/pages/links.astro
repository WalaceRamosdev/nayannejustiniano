---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import heroineImage from '../assets/images/processed_image_4.png';
import clientLogo from '../assets/images/logo.png';

const links = [
  { 
    title: "Agendar Sessão", 
    desc: "Inicie seu processo de escuta profunda via WhatsApp.",
    href: "https://wa.me/5531991838243", 
    highlight: true,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>`
  },
  { 
    title: "Site Oficial", 
    desc: "Conhecer minha filosofia e método de atendimento.",
    href: "/", 
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" x2="22" y1="12" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>`
  },
  { 
    title: "Localização", 
    desc: "Consultório presencial em Almenara, Minas Gerais.",
    href: "https://goo.gl/maps/placeholder", 
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>`
  },
];
---

<Layout title="Conexões | Nayanne Justiniano">
  <main class="min-h-screen bg-[#F3F0E9] flex flex-col items-center justify-start px-6 py-20 relative overflow-hidden">
    <!-- Immersive Background -->
    <div class="fixed inset-0 z-0 pointer-events-none">
       <div class="absolute top-[-20%] left-[-10%] w-[80vw] h-[80vw] bg-brand-gold/5 rounded-full blur-[150px]"></div>
       <div class="absolute bottom-[-20%] right-[-10%] w-[60vw] h-[60vw] bg-brand-blue/5 rounded-full blur-[150px]"></div>
       <div class="absolute inset-0 opacity-[0.03] grain-bg"></div>
    </div>

    <div class="w-full max-w-lg relative z-10 flex flex-col items-center">
       <!-- Profile Section -->
       <div class="relative mb-8 group scroll-reveal">
          <div class="w-40 h-52 bg-white rounded-t-full border border-brand-gold/20 overflow-hidden shadow-2xl relative">
             <Image src={heroineImage} alt="Nayanne Justiniano" class="w-full h-full object-cover object-top scale-105 group-hover:scale-100 transition-transform duration-1000" />
             <div class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-[#F3F0E9] to-transparent pointer-events-none"></div>
          </div>
          <div class="absolute -bottom-4 -right-4 w-12 h-12 bg-brand-gold rounded-full flex items-center justify-center text-white shadow-xl animate-float">
             <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-3.5-6.5c0 2.5-1.5 4.9-3.5 6.5S6 13 6 15a7 7 0 0 0 7 7Z"/></svg>
          </div>
       </div>

       <div class="text-center mb-12 scroll-reveal text-brand-blue" style="transition-delay: 200ms;">
          <div class="inline-flex items-center bg-white/50 backdrop-blur-md px-6 py-3 rounded-full border border-white/40 shadow-sm mb-6">
             <Image src={clientLogo} alt="Logo" class="h-8 w-auto brightness-[0.3] contrast-125" />
          </div>
          <h1 class="font-serif text-4xl mb-2 tracking-tighter">Nayanne Justiniano</h1>
          <p class="text-[0.6rem] uppercase tracking-[0.5em] font-black text-brand-gold/80">Psicóloga / CRP 04/84986</p>
       </div>

       <!-- Links Cards -->
       <div class="w-full space-y-4">
          {links.map((link, idx) => (
            <a 
              href={link.href} 
              target={link.href.startsWith('http') ? "_blank" : "_self"}
              class={`group relative flex items-center p-6 rounded-[2rem] transition-all duration-500 scroll-reveal ${
                link.highlight 
                ? "bg-brand-blue text-white shadow-2xl shadow-brand-blue/20 scale-[1.02]" 
                : "bg-white/40 backdrop-blur-xl border border-white/60 hover:bg-white hover:border-white shadow-sm"
              }`}
              style={`transition-delay: ${300 + (idx * 100)}ms;`}
            >
              <div class={`w-14 h-14 rounded-2xl flex items-center justify-center mr-6 transition-all duration-500 ${
                link.highlight ? "bg-brand-gold text-brand-blue" : "bg-brand-blue/5 text-brand-blue group-hover:bg-brand-gold group-hover:text-white"
              }`}>
                <Fragment set:html={link.icon} />
              </div>
              <div class="flex-1">
                <span class="block text-sm font-bold uppercase tracking-widest mb-1">{link.title}</span>
                <span class={`block text-[0.7rem] font-light leading-tight ${link.highlight ? "text-white/60" : "text-brand-blue/50"}`}>{link.desc}</span>
              </div>
              <div class={`opacity-0 group-hover:opacity-100 translate-x-4 group-hover:translate-x-0 transition-all duration-500 ${link.highlight ? "text-brand-gold" : "text-brand-gold"}`}>
                 <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
              </div>
            </a>
          ))}
       </div>

       <!-- Social Links -->
       <div class="mt-12 flex gap-8 scroll-reveal" style="transition-delay: 800ms;">
          <a href="https://instagram.com" class="text-brand-blue/40 hover:text-brand-gold transition-colors">
             <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
          </a>
       </div>

       <div class="mt-16 text-center scroll-reveal" style="transition-delay: 900ms;">
          <p class="text-[0.55rem] uppercase tracking-[0.4em] text-brand-blue/20 mb-4 font-bold">@ 2026 Todos os direitos reservados</p>
          <a href="/" class="text-[0.6rem] uppercase tracking-[0.6em] font-black text-brand-blue/40 hover:text-brand-gold transition-colors inline-flex items-center gap-4">
             <div class="w-8 h-px bg-brand-gold/30"></div>
             Voltar ao site
          </a>
       </div>
    </div>
  </main>
</Layout>

<style>
  .grain-bg {
    background-image: url("https://grainy-gradients.vercel.app/noise.svg");
  }
  @keyframes float {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-10px) rotate(5deg); }
  }
  .animate-float {
    animation: float 6s ease-in-out infinite;
  }
</style>
