---
interface Props {
	title: string;
  description?: string;
}

const { title, description = "Psicóloga Nayanne Justiniano - Atendimento em Almenara, MG e Online." } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="shortcut icon" href="/favicon.png" />
		<link rel="canonical" href="https://nayanne-justiniano-psicologa.vercel.app/" />
		<meta name="generator" content={Astro.generator} />
    
    <!-- SEO -->
    <title>{title} | Nayanne Justiniano | Psicóloga em Almenara, MG</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="psicóloga almenara, psicoterapia online, nayanne justiniano, fenomenologia existencial, psicóloga em bh, saúde mental almenara, terapia online brasil" />
    <meta name="author" content="Nayanne Justiniano" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Meta Social -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://nayanne-justiniano-psicologa.vercel.app/" />
    <meta property="og:title" content={`${title} | Nayanne Justiniano`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/favicon.png" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://nayanne-justiniano-psicologa.vercel.app/" />
    <meta property="twitter:title" content={`${title} | Nayanne Justiniano`} />
    <meta property="twitter:description" content={description} />


		<!-- Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Prata&family=Outfit:wght@200;300;400;500&display=swap" rel="stylesheet">
	</head>
  <body class="bg-[#FAF9F6] text-[#0A121E] font-sans selection:bg-brand-gold/20 selection:text-brand-blue antialiased">
    <!-- Sophisticated Grain Overlay -->
    <div class="fixed inset-0 pointer-events-none z-[100] opacity-[0.02] mix-blend-multiply grain-bg"></div>
    
    <!-- Atmospheric Background Glow -->
    <div class="fixed -top-[20%] -left-[10%] w-[50vw] h-[50vw] bg-brand-gold/5 blur-[150px] rounded-full pointer-events-none -z-10"></div>
    <div class="fixed -bottom-[20%] -right-[10%] w-[40vw] h-[40vw] bg-brand-blue/5 blur-[120px] rounded-full pointer-events-none -z-10"></div>

		<slot />
    
    <style is:global>
      :root {
        --brand-bg: #FAF9F6;
        --brand-blue: #0A121E;
        --brand-sand: #E3D9C6;
        --brand-gold: #C5A059;
        --brand-accent: #1E3A5F;
      }
      
      .grain-bg {
        background-image: url("https://grainy-gradients.vercel.app/noise.svg");
      }

      html {
        scroll-behavior: auto;
      }
      
      body {
        overflow-x: hidden;
        background-color: var(--brand-bg);
        color: var(--brand-blue);
      }

      .font-serif {
        font-family: 'Prata', serif;
      }
      
      .font-sans {
        font-family: 'Outfit', sans-serif;
      }

      .scroll-reveal {
        opacity: 0;
        transform: translateY(20px);
        transition: opacity 1.5s cubic-bezier(0.22, 1, 0.36, 1), transform 1.5s cubic-bezier(0.22, 1, 0.36, 1);
      }

      .scroll-reveal.active {
        opacity: 1 !important;
        transform: translateY(0);
      }

      /* Premium Typography Details */
      h1, h2, h3 {
        text-wrap: balance;
      }

      /* Custom Scrollbar (Subtle Gold) */
      ::-webkit-scrollbar {
        width: 4px;
      }
      ::-webkit-scrollbar-track {
        background: var(--brand-bg);
      }
      ::-webkit-scrollbar-thumb {
        background: var(--brand-gold);
        border-radius: 10px;
      }
    </style>

    <!-- Smooth Scroll & Reveal Logic -->
    <script is:inline src="https://unpkg.com/@studio-freight/lenis@1.0.33/dist/lenis.min.js"></script>
    <script is:inline>
      function initApp() {
        // Init Lenis
        if (typeof Lenis !== 'undefined') {
          const lenis = new Lenis({
            duration: 1.2,
            easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
            smoothWheel: true,
          })
          function raf(time) {
            lenis.raf(time)
            requestAnimationFrame(raf)
          }
          requestAnimationFrame(raf)
        }

        // Init Reveal
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('active');
            }
          });
        }, { threshold: 0.05 });

        document.querySelectorAll('.scroll-reveal').forEach(el => {
          observer.observe(el);
          // Check if already in view
          const rect = el.getBoundingClientRect();
          if (rect.top < window.innerHeight) {
            el.classList.add('active');
          }
        });
        
        // Safety reveal
        setTimeout(() => {
          document.querySelectorAll('.scroll-reveal').forEach(el => {
            if (!el.classList.contains('active')) {
              el.classList.add('active');
            }
          });
        }, 2000);
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initApp);
      } else {
        initApp();
      }
    </script>
	</body>
</html>
